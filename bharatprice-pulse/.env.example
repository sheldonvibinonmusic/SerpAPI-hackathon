# ===========================================================================
# BharatPrice Pulse — Environment Variables
# Copy this file to .env and insert your real keys.
# NEVER commit your real .env file to version control.
# ===========================================================================

# SerpApi Key (Required for live mode — 250 free searches/month)
# Get your free key at: https://serpapi.com
SERPAPI_KEY=

# Mock Mode (Set to true for zero-credit local testing & UI design)
# Set to false only for live verification and hackathon video demo
SERPAPI_MOCK_MODE=true

# Google Gemini API Key (Optional — bounded explainer, not required for core math)
GEMINI_API_KEY=
LLM_ENABLED=false

# Application Configuration
APP_PORT=8000
DEBUG=false
DATABASE_PATH=data/bharatprice_pulse.db
